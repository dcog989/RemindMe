[Desktop Entry]
Name=Remind me
Comment=Start, list and cancel timers
Type=Service
Icon=kronometer
X-KDE-PluginInfo-Author=dcog989
X-KDE-PluginInfo-Name=remindme
X-KDE-PluginInfo-Version=@PROJECT_VERSION@
X-KDE-PluginInfo-License=GPL-3.0-or-later
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus2
X-Plasma-DBusRunner-Service=io.github.dcog989.remindme
X-Plasma-DBusRunner-Path=/
X-Plasma-Request-Actions-Once=true
# Trigger words below must match s_triggerWords in src/runner/remindmeadaptor.cpp.
X-Plasma-Runner-Syntaxes=remindme <duration> [<message>],rme <duration> [<message>],rme list,rme cancel <id>,rme cancel <message>
X-Plasma-Runner-Syntax-Descriptions=Create and manage timers.,Create and manage timers.,List timers,Cancel timers with given id,Cancel all timers matching given message
